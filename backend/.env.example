# Scaleway Object Storage (S3 compatible)
# Keep bucket name only in SCALEWAY_BUCKET_NAME (without trailing slash/path).
# Use SCALEWAY_FOLDER for the logical folder prefix.
SCALEWAY_ACCESS_KEY=__SET_ME__
SCALEWAY_SECRET_KEY=__SET_ME__
SCALEWAY_ENDPOINT=https://s3.fr-par.scw.cloud
SCALEWAY_BUCKET_NAME=paris
SCALEWAY_REGION=fr-par
SCALEWAY_FOLDER=grp4

# Runtime
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://samuel-corinthe.students-laplateforme.io

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=__SET_ME__
DB_PASSWORD=__SET_ME__
DB_NAME=__SET_ME__

# Session/Auth
SESSION_SECRET=__SET_ME_LONG_RANDOM__
SESSION_COOKIE_NAME=marsai_sid
SESSION_TTL_SECONDS=28800
WP_BASE_URL=https://samuel-corinthe.students-laplateforme.io/MarsAi
WP_AUTH_MODE=auto
WP_FALLBACK_ROLE=admin

# YouTube OAuth
GOOGLE_CLIENT_ID=__SET_ME__
GOOGLE_CLIENT_SECRET=__SET_ME__
GOOGLE_REDIRECT_URI=__SET_ME__
GOOGLE_REFRESH_TOKEN=__SET_ME__

# Email/Brevo
BREVO_API_KEY=__OPTIONAL__
EMAIL_USER=__OPTIONAL__
MAIL_PASS=__OPTIONAL__
EMAIL_FROM=__OPTIONAL__
